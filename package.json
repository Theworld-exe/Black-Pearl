{
  "name": "black-pearl",
  "private": true,
  "version": "0.1.6",
  "description": "Modular Electron desktop game launcher, library organizer, and Aria2-powered download manager.",
  "license": "MIT",
  "author": "Theworld-exe",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "game-launcher",
    "download-manager",
    "aria2",
    "desktop-app"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Theworld-exe/black-pearl.git"
  },
  "homepage": "https://github.com/Theworld-exe/black-pearl#readme",
  "bugs": {
    "url": "https://github.com/Theworld-exe/black-pearl/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "vite build && electron-builder",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.34.0",
    "aria2": "^5.0.0",
    "axios": "^1.16.0",
    "cheerio": "^1.2.0",
    "cross-fetch": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "v8-compile-cache": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10",
    "vite-plugin-electron": "^0.28.0"
  },
  "build": {
    "appId": "com.theworldexe.blackpearl",
    "productName": "Black Pearl",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "extensions/**/*",
      "package.json"
    ],
    "win": {
      "extraResources": [
        "aria2c.exe"
      ],
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "mac": {
      "extraResources": [
        "aria2c"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Theworld-exe",
        "repo": "black-pearl"
      }
    ]
  }
}
