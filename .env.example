# Black Pearl Environment Variables
# Copy this file to `.env` (never commit `.env`) or set these in your shell environment.

# Optional: Discord Application Client ID used for Discord Rich Presence.
# Defaults to the built-in placeholder ID if omitted.
DISCORD_CLIENT_ID=

# Optional: Base URL for remote marketplace extension `.js` files
# (e.g. https://raw.githubusercontent.com/Theworld-exe/black-pearl-extensions/main).
# Built-in extensions work offline from `./extensions/` and embedded templates even when unset.
BLACK_PEARL_EXTENSIONS_URL=

# Automatically injected by vite-plugin-electron during `npm run dev`.
# Leave unset for production builds.
# VITE_DEV_SERVER_URL=http://localhost:5173
